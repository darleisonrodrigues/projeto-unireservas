# ════════════════════════════════════════════════════════════════
#  Variáveis da stack de observabilidade — copie para .env
# ════════════════════════════════════════════════════════════════

# Credenciais do Grafana (troque em ambientes não-locais!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# URI da UI web do Locust que o exporter irá consultar.
# - Locust rodando no host (padrão):  http://host.docker.internal:8089
# - Locust em outra máquina/porta:     http://<host>:<porta>
LOCUST_URI=http://host.docker.internal:8089
