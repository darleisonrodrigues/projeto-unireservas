{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["unireservas", "locust", "loadtest"],
  "templating": {
    "list": [
      { "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0, "label": "Datasource", "name": "DS_PROMETHEUS", "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "UniReservas — Locust Load Test",
  "uid": "unireservas-locust",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Usuários virtuais",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "id": 1,
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "locust_users" } ]
    },
    {
      "type": "stat",
      "title": "RPS atual",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(locust_requests_current_rps{name=\"Aggregated\"})" } ]
    },
    {
      "type": "stat",
      "title": "Falhas / s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(locust_requests_current_fail_per_sec{name=\"Aggregated\"})" } ]
    },
    {
      "type": "stat",
      "title": "Total de falhas",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "id": 4,
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(locust_requests_num_failures{name=\"Aggregated\"})" } ]
    },
    {
      "type": "stat",
      "title": "Estado",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" }, "mappings": [ { "type": "value", "options": { "0": { "text": "PARADO", "color": "red" }, "1": { "text": "INICIANDO", "color": "yellow" }, "2": { "text": "ATIVO", "color": "green" } } } ] }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "locust_running" } ]
    },
    {
      "type": "timeseries",
      "title": "Usuários x RPS x Falhas/s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 6,
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [ { "matcher": { "id": "byName", "options": "usuários" }, "properties": [ { "id": "custom.axisPlacement", "value": "right" } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "locust_users", "legendFormat": "usuários" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(locust_requests_current_rps{name=\"Aggregated\"})", "legendFormat": "rps" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(locust_requests_current_fail_per_sec{name=\"Aggregated\"})", "legendFormat": "falhas/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo de resposta agregado (mediana / média / máx)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 7,
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_median_response_time{name=\"Aggregated\"}", "legendFormat": "mediana" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_avg_response_time{name=\"Aggregated\"}", "legendFormat": "média" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_max_response_time{name=\"Aggregated\"}", "legendFormat": "máx" }
      ]
    },
    {
      "type": "timeseries",
      "title": "RPS por endpoint (Locust)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "id": 8,
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_current_rps{name!=\"Aggregated\"}", "legendFormat": "{{method}} {{name}}" }
      ]
    },
    {
      "type": "table",
      "title": "Estatísticas por endpoint",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "id": 9,
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [
        { "matcher": { "id": "byName", "options": "mediana (ms)" }, "properties": [ { "id": "unit", "value": "ms" } ] },
        { "matcher": { "id": "byName", "options": "média (ms)" }, "properties": [ { "id": "unit", "value": "ms" } ] }
      ] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "requests", "desc": true } ] },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_num_requests{name!=\"Aggregated\"}", "legendFormat": "" },
        { "refId": "B", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_num_failures{name!=\"Aggregated\"}", "legendFormat": "" },
        { "refId": "C", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_median_response_time{name!=\"Aggregated\"}", "legendFormat": "" },
        { "refId": "D", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "locust_requests_avg_response_time{name!=\"Aggregated\"}", "legendFormat": "" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true, "service": true, "component": true },
          "renameByName": {
            "method": "método", "name": "endpoint",
            "Value #A": "requests", "Value #B": "falhas",
            "Value #C": "mediana (ms)", "Value #D": "média (ms)"
          } } }
      ]
    }
  ]
}
